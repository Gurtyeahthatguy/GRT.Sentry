{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRT Sentry",
  "version": "0.1.0",
  "identifier": "org.grt.sentry",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GRT Sentry",
        "width": 1060,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "GRT Project",
    "category": "Utility",
    "shortDescription": "Local security scanner",
    "longDescription": "Checks files, network connections, autostart entries, system integrity and pending updates, and offers a concrete action for every problem it finds.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "nftables"
        ]
      }
    },
    "resources": [
      "resources/GeoLite2-COPYRIGHT.txt",
      "resources/GeoLite2-LICENSE.txt"
    ]
  }
}
