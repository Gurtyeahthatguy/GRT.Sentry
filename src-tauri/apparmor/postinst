#!/bin/sh
# SPDX-License-Identifier: MIT
# Load the profile now, rather than at the next reboot.
set -e
if [ "$1" = "configure" ] && command -v apparmor_parser >/dev/null 2>&1; then
    if [ -d /sys/kernel/security/apparmor ]; then
        apparmor_parser -r -T -W /etc/apparmor.d/usr.bin.grt-sentry 2>/dev/null || true
    fi
fi
exit 0
